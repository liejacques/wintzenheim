---
import { mainNav, utilityNav } from "../data/nav";

const today = new Intl.DateTimeFormat("fr-FR", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(new Date());

const searchLinks = [
  { label: "Horaires et contact de la mairie", href: "/#pratique", meta: "Adresse, téléphone et horaires", keywords: "mairie ouverture téléphone email adresse" },
  { label: "État civil et papiers", href: "/demarches/#etat-civil", meta: "Actes, mariage, PACS, recensement", keywords: "naissance décès passeport cni carte identité" },
  { label: "Déchets et collecte", href: "/dechets/", meta: "Calendrier, tri et déchèterie", keywords: "poubelle bac ordures recyclage" },
  { label: "Urbanisme", href: "/demarches/#urbanisme", meta: "Permis et déclarations", keywords: "travaux plu construction déclaration" },
  { label: "Écoles et périscolaire", href: "/vie-locale/#ecoles", meta: "Inscriptions, cantine et accueil", keywords: "enfant scolaire crèche jeunesse" },
  { label: "Agenda de la commune", href: "/#agenda", meta: "Les prochains rendez-vous", keywords: "sortie fête marché événement" },
  { label: "Signaler un problème", href: "/signalement/", meta: "Voirie, éclairage ou propreté", keywords: "incident nid poule lampadaire route" },
  { label: "Annuaire local", href: "/annuaire/", meta: "Commerces, artisans, associations", keywords: "commercants entreprises medecin pharmacie associations" },
];

const chevron = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>';
---

<header class="site-header">
  <div class="masthead-top">
    <div class="container masthead-top__inner">
      <a class="office-state" href="/#pratique">
        <span class="office-state__dot" data-office-dot aria-hidden="true"></span>
        <span data-office-status>Consulter les horaires de la mairie</span>
      </a>
      <span class="masthead-top__date" id="js-today">{today}</span>
      <nav class="masthead-top__nav" aria-label="Liens utiles">
        {utilityNav.map((l) => <a href={l.href}>{l.label}</a>)}
        <button class="masthead-top__search" type="button" data-search-open>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
          Rechercher
        </button>
      </nav>
    </div>
  </div>

  <div class="masthead">
    <div class="masthead__rule" aria-hidden="true"></div>
    <div class="container masthead__inner">
      <a class="brand" href="/" aria-label="Wintzenheim, accueil">
        <img
          class="brand__blason"
          src="/blason.svg"
          width="46"
          height="51"
          alt="Blason de Wintzenheim : un lévrier d'argent sur champ de sinople"
          decoding="async"
          data-egg
        />
        <span class="brand__text">
          <span class="brand__name">Wintzenheim</span>
          <span class="brand__tag">Ville d'Alsace · Haut-Rhin</span>
        </span>
      </a>

      <nav class="mainnav" aria-label="Navigation principale">
        {mainNav.map((item) => item.children ? (
          <details class="navitem">
            <summary>
              {item.label}
              <Fragment set:html={chevron} />
            </summary>
            <div class="navitem__panel">
              <a class="navitem__overview" href={item.href}>Vue d'ensemble</a>
              {item.children.map((child) => <a href={child.href}>{child.label}</a>)}
            </div>
          </details>
        ) : (
          <a class="mainnav__link" href={item.href}>{item.label}</a>
        ))}
        <button class="nav-search" type="button" data-search-open aria-label="Rechercher un service">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
        </button>
        <a class="btn btn--primary mainnav__cta" href="/demarches/">
          Mes démarches
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
        </a>
      </nav>

      <div class="mobile-actions">
        <button class="mobile-actions__search" type="button" data-search-open aria-label="Rechercher un service">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
        </button>
        <details class="mobile-menu">
          <summary aria-label="Ouvrir le menu principal" data-testid="mobile-menu-toggle">
            <svg class="ico-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg class="ico-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
            <span class="mobile-menu__label">Menu</span>
          </summary>
          <span class="mobile-menu__scrim" data-menu-close aria-hidden="true"></span>
          <nav class="mobile-menu__panel" aria-label="Navigation mobile">
            <p class="mobile-menu__heading">Navigation</p>
            <button type="button" class="mobile-menu__search" data-search-open>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
              Rechercher un service
            </button>
            <div class="mobile-menu__quick">
              {utilityNav.map((l) => <a href={l.href}>{l.label}</a>)}
            </div>
            {mainNav.map((item) => (
              <div class="mobile-menu__group">
                <a class="mobile-menu__parent" href={item.href}>{item.label}</a>
                {item.children && (
                  <div class="mobile-menu__children">
                    {item.children.map((child) => <a href={child.href}>{child.label}</a>)}
                  </div>
                )}
              </div>
            ))}
            <a class="mobile-menu__cta" href="/demarches/">
              Accéder à mes démarches
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
            </a>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

<dialog class="search-dialog" id="site-search" aria-labelledby="search-dialog-title">
  <div class="search-dialog__inner">
    <form method="dialog" class="search-dialog__head">
      <div>
        <p class="search-dialog__eyebrow">Accès direct</p>
        <h2 id="search-dialog-title">Que cherchez-vous&nbsp;?</h2>
      </div>
      <button type="button" class="search-dialog__close" data-search-close aria-label="Fermer la recherche">×</button>
    </form>
    <label class="search-field" for="quick-search">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
      <input id="quick-search" type="search" autocomplete="off" aria-label="Rechercher un service" placeholder="Ex. déchets, passeport, horaires…" data-search-input />
    </label>
    <p class="search-dialog__hint">Les services les plus demandés sont accessibles immédiatement.</p>
    <ul class="search-results" data-search-results>
      {searchLinks.map((link) => (
        <li data-search-item data-search-text={`${link.label} ${link.meta} ${link.keywords}`}>
          <a href={link.href}>
            <span><strong>{link.label}</strong><small>{link.meta}</small></span>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
          </a>
        </li>
      ))}
    </ul>
    <p class="search-empty" data-search-empty hidden>Aucun accès rapide ne correspond. Utilisez le formulaire de contact pour être orienté.</p>
  </div>
</dialog>

<nav class="mobile-dock" aria-label="Accès rapides sur mobile">
  <a href="tel:+33389279494">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 3h3l1.5 4-2 1.5a15 15 0 0 0 6 6l1.5-2 4 1.5v3c0 2-2 4-4 4C9 20 4 15 3 7c0-2 2-4 4-4Z"/></svg>
    <span>Appeler</span>
  </a>
  <button type="button" data-search-open>
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
    <span>Trouver</span>
  </button>
  <a href="/#pratique">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
    <span>Horaires</span>
  </a>
</nav>

<style>
  .site-header {
    position: relative;
    z-index: 100;
  }
  .masthead-top {
    background: var(--creme-2);
    color: var(--muted);
    border-bottom: 1px solid var(--trait);
    font-size: 13px;
  }
  .masthead-top__inner {
    min-height: 34px;
    display: flex;
    align-items: center;
    gap: 20px;
    padding-block: 5px;
  }
  .office-state {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--encre);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }
  .office-state:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .office-state__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-gold-strong);
    box-shadow: 0 0 0 3px rgba(169, 132, 42, 0.16);
  }
  .office-state__dot.is-open {
    background: #2f9c54;
    box-shadow: 0 0 0 3px rgba(47, 156, 84, 0.16);
  }
  .masthead-top__date {
    margin-left: auto;
    opacity: 0.78;
    text-transform: capitalize;
  }
  .masthead-top__nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .masthead-top__nav a,
  .masthead-top__search {
    color: inherit;
    text-decoration: none;
    opacity: 0.88;
  }
  .masthead-top__nav a:hover,
  .masthead-top__search:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .masthead-top__search {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 0;
    padding: 0;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }
  .masthead {
    position: relative;
    background: rgba(248, 246, 239, 0.97);
    border-bottom: 1px solid var(--trait);
    box-shadow: 0 8px 28px rgba(22, 64, 31, 0.06);
  }
  .masthead__rule {
    height: 3px;
    background: var(--or);
  }
  .masthead__inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    color: inherit;
    text-decoration: none;
    flex: none;
  }
  .brand__blason {
    width: 46px;
    height: auto;
  }
  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .brand__name {
    font-family: var(--serif);
    font-size: 29px;
    font-weight: 600;
  }
  .brand__tag {
    margin-top: 5px;
    color: var(--muted);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .mainnav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.8vw, 24px);
    font-size: 15px;
    font-weight: 600;
  }
  .mainnav__link,
  .navitem > summary {
    color: inherit;
    text-decoration: none;
    padding: 26px 0;
  }
  .mainnav__link:hover,
  .navitem > summary:hover,
  .navitem[open] > summary {
    color: var(--sinople);
  }
  .navitem {
    position: relative;
  }
  .navitem > summary {
    display: flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    list-style: none;
  }
  .navitem > summary::-webkit-details-marker {
    display: none;
  }
  .navitem[open] > summary svg {
    transform: rotate(180deg);
  }
  .navitem__panel {
    position: absolute;
    top: calc(100% - 8px);
    left: -18px;
    width: 260px;
    display: grid;
    padding: 10px;
    background: var(--creme-2);
    border: 1px solid var(--trait);
    border-top: 2px solid var(--or);
    box-shadow: 0 18px 38px rgba(22, 64, 31, 0.14);
  }
  .navitem__panel a {
    padding: 9px 11px;
    color: var(--encre);
    text-decoration: none;
    font-size: 14.5px;
    line-height: 1.35;
  }
  .navitem__panel a:hover {
    background: rgba(31, 107, 58, 0.07);
    color: var(--sinople);
  }
  .navitem__panel .navitem__overview {
    color: var(--sinople);
    border-bottom: 1px solid var(--trait);
    margin-bottom: 4px;
  }
  .nav-search {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    flex: none;
    border: 1px solid var(--trait-fort);
    background: transparent;
    color: var(--encre);
    cursor: pointer;
  }
  .nav-search:hover {
    border-color: var(--sinople);
    color: var(--sinople);
  }
  .mainnav__cta {
    min-height: 44px;
    padding: 11px 16px;
    font-size: 14.5px;
    white-space: nowrap;
  }
  .mobile-actions,
  .mobile-dock {
    display: none;
  }

  .search-dialog {
    width: min(680px, calc(100vw - 32px));
    max-height: min(760px, calc(100vh - 32px));
    padding: 0;
    border: 0;
    border-top: 4px solid var(--or);
    background: var(--creme-2);
    color: var(--encre);
    box-shadow: 0 26px 80px rgba(10, 32, 16, 0.3);
  }
  .search-dialog::backdrop {
    background: rgba(12, 30, 17, 0.7);
    backdrop-filter: blur(3px);
  }
  /* Apparition / fermeture douces (symétriques) */
  .search-dialog[open] {
    animation: sd-in 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .search-dialog.is-closing {
    animation: sd-out 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes sd-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes sd-out {
    from { opacity: 1; transform: none; }
    to { opacity: 0; transform: translateY(8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .search-dialog[open],
    .search-dialog.is-closing {
      animation: none;
    }
  }
  .search-dialog__inner {
    padding: clamp(24px, 5vw, 42px);
  }
  .search-dialog__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }
  .search-dialog__eyebrow {
    margin: 0 0 6px;
    color: var(--sinople);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .search-dialog h2 {
    margin: 0;
    font-size: clamp(30px, 5vw, 46px);
  }
  .search-dialog__close {
    width: 44px;
    height: 44px;
    flex: none;
    border: 1px solid var(--trait-fort);
    background: transparent;
    color: var(--encre);
    font-size: 27px;
    line-height: 1;
    cursor: pointer;
  }
  .search-field {
    min-height: 58px;
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 0 18px;
    border: 2px solid var(--sinople);
    background: #fff;
    color: var(--sinople);
  }
  .search-field input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--encre);
    font: 500 17px/1.2 var(--sans);
  }
  .search-dialog__hint {
    margin: 10px 0 18px;
    color: var(--muted);
    font-size: 13.5px;
  }
  .search-results {
    max-height: 390px;
    overflow-y: auto;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--trait);
  }
  .search-results li {
    border-bottom: 1px solid var(--trait);
  }
  .search-results a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 14px 4px;
    color: inherit;
    text-decoration: none;
  }
  .search-results a:hover strong {
    color: var(--sinople);
  }
  .search-results span,
  .search-results small {
    display: block;
  }
  .search-results strong {
    font-size: 16px;
  }
  .search-results small {
    margin-top: 2px;
    color: var(--muted);
    font-size: 13.5px;
  }
  .search-results svg {
    color: var(--sinople);
    flex: none;
  }
  .search-empty {
    color: var(--muted);
    font-size: 15px;
  }

  @media (max-width: 1080px) {
    .mainnav {
      display: none;
    }
    .mobile-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .mobile-actions__search,
    .mobile-menu > summary {
      min-width: 44px;
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--trait-fort);
      background: transparent;
      color: var(--encre);
      cursor: pointer;
    }
    .mobile-actions__search {
      padding: 0;
    }
    /* En-tête collant sur mobile : la navigation et la recherche restent
       accessibles même après avoir fait défiler la page. (On colle tout le
       <header> : un enfant seul ne pourrait pas coller au-delà de son parent.) */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 180;
    }
    .mobile-menu {
      position: static;
    }
    .mobile-menu > summary {
      gap: 7px;
      padding: 0 13px;
      list-style: none;
      font-size: 14px;
      font-weight: 700;
    }
    .mobile-menu > summary::-webkit-details-marker {
      display: none;
    }
    /* Le pictogramme « hamburger » devient « ✕ » à l'ouverture (ferme sans JS). */
    .mobile-menu .ico-close {
      display: none;
    }
    .mobile-menu[open] .ico-menu {
      display: none;
    }
    .mobile-menu[open] .ico-close {
      display: block;
    }

    /* Voile sombre derrière le tiroir */
    .mobile-menu__scrim {
      position: fixed;
      inset: 0;
      z-index: 150;
      background: rgba(12, 30, 17, 0.55);
      animation: mm-fade 0.25s ease;
    }
    /* Tiroir qui glisse depuis la droite */
    .mobile-menu__panel {
      position: fixed;
      z-index: 160;
      inset: 0 0 0 auto;
      width: min(360px, 88vw);
      height: 100dvh;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 116px 20px calc(28px + env(safe-area-inset-bottom, 0px));
      background: var(--creme-2);
      border-left: 3px solid var(--or);
      box-shadow: -20px 0 50px rgba(12, 30, 17, 0.3);
      animation: mm-slide 0.28s cubic-bezier(0.2, 0.7, 0.25, 1);
    }
    @keyframes mm-slide {
      from { transform: translateX(100%); }
      to { transform: translateX(0); }
    }
    @keyframes mm-fade {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    .mobile-menu__heading {
      margin: 0 0 10px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--sinople);
    }
    .mobile-menu__search {
      width: 100%;
      min-height: 48px;
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0 0 8px;
      padding: 0 16px;
      border: 1px solid var(--trait-fort);
      background: #fff;
      color: var(--muted);
      font: 500 15px/1 var(--sans);
      text-align: left;
      cursor: pointer;
    }
    .mobile-menu__search svg {
      color: var(--sinople);
      flex: none;
    }
    .mobile-menu__search:hover {
      border-color: var(--sinople);
      color: var(--encre);
    }
    .mobile-menu__quick {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0 0 16px;
    }
    .mobile-menu__quick a {
      min-height: 38px;
      display: inline-flex;
      align-items: center;
      padding: 8px 14px;
      border: 1px solid var(--trait-fort);
      border-radius: 999px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--encre);
      text-decoration: none;
    }
    .mobile-menu__quick a:first-child {
      background: var(--sinople);
      border-color: var(--sinople);
      color: #fff;
    }
    .mobile-menu__quick a:hover {
      border-color: var(--sinople);
      color: var(--sinople);
      background: var(--color-primary-soft);
    }
    .mobile-menu__quick a:first-child:hover {
      background: var(--sinople-fonce);
      color: #fff;
    }
    .mobile-menu__group {
      padding: 4px 0;
      border-bottom: 1px solid var(--trait);
    }
    .mobile-menu__parent {
      display: flex;
      align-items: center;
      min-height: 48px;
      color: var(--encre);
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 600;
      text-decoration: none;
    }
    .mobile-menu__parent:hover {
      color: var(--sinople);
    }
    .mobile-menu__children {
      display: grid;
      gap: 2px;
      margin: 0 0 8px;
      padding-left: 14px;
