---
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import { sites, chronologie, personnalites, blason } from "../../../data/patrimoine";
import { photos } from "../../../data/photos";

// Association site → photo (quand elle existe)
const siteImage: Record<string, keyof typeof photos> = {
  "Château du Hohlandsbourg": "chateau",
  "Église Saint-Laurent": "egliseSaintLaurent",
  "Synagogue": "synagogue",
  "Hôtel de ville (ancien Thurnburg)": "mairie",
};
---

<Base
  title="Patrimoine & histoire — Wintzenheim"
  description="Le patrimoine de Wintzenheim : château du Hohlandsbourg, Pflixbourg, église Saint-Laurent, synagogue néo-romane, hôtel de ville médiéval. Chronologie, personnalités et blason de la commune."
  ogImage={photos.synagogue.image.src}
>
  <PageHero
    kicker="Patrimoine & terroir"
    title="Patrimoine & histoire"
    lede="De la première mention de « Wingisheim » en 786 aux châteaux des Vosges, Wintzenheim conserve un patrimoine dense : forteresses, églises, synagogue et hôtel de ville médiéval."
    crumbs={[{ label: "Découvrir", href: "/decouvrir/" }, { label: "Patrimoine & histoire" }]}
  />

  <!-- Sites patrimoniaux -->
  <section class="section sites" aria-labelledby="sites-t">
    <div class="container section__pad">
      <p class="kicker"><span class="kicker__tick"></span><span class="kicker__label">À voir</span></p>
      <h2 id="sites-t" class="block-title">Les sites patrimoniaux</h2>
      <div class="sites__list">
        {sites.map((s, i) => {
          const key = siteImage[s.nom];
          const photo = key ? photos[key] : null;
          return (
            <article class={`site ${photo ? "site--media" : ""} ${i % 2 === 1 ? "site--alt" : ""}`}>
              {photo && (
                <figure class="site__media">
                  <Image src={photo.image} alt={photo.alt} widths={[400, 700]} sizes="(max-width: 820px) 100vw, 42vw" loading="lazy" />
                  <figcaption class="credit credit--overlay">{photo.credit}</figcaption>
                </figure>
              )}
              <div class="site__text">
                <span class="site__periode">{s.periode}</span>
                <h3 class="site__nom">{s.nom}</h3>
                <p class="site__resume">{s.resume}</p>
                <p class="site__detail">{s.detail}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Chronologie -->
  <section class="section--dark chrono" aria-labelledby="chrono-t">
    <div class="container section__pad">
      <p class="kicker kicker--gold"><span class="kicker__tick"></span><span class="kicker__label">Repères</span></p>
      <h2 id="chrono-t" class="block-title block-title--light">Quelques dates</h2>
      <ol class="timeline">
        {chronologie.map((c) => (
          <li class="tl">
            <span class="tl__annee">{c.annee}</span>
            <span class="tl__evt">{c.evt}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Personnalités -->
  <section class="section perso" aria-labelledby="perso-t">
    <div class="container section__pad">
      <p class="kicker"><span class="kicker__tick"></span><span class="kicker__label">Ils ont marqué la commune</span></p>
      <h2 id="perso-t" class="block-title">Personnalités</h2>
      <div class="perso__grid">
        {personnalites.map((p) => (
          <article class="perso-card">
            <strong class="perso-card__nom">{p.nom}</strong>
            <p class="perso-card__role">{p.role}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Blason -->
  <section class="section--sinople blason" aria-labelledby="blason-t">
    <div class="container section__pad">
      <div class="blason__grid">
        <img class="blason__img" src="/blason.svg" width="120" height="134" alt="Blason de Wintzenheim : un lévrier d'argent, colleté et bouclé d'or, sur champ de sinople." decoding="async" data-egg />
        <div>
          <p class="kicker kicker--gold"><span class="kicker__tick"></span><span class="kicker__label">Armes parlantes</span></p>
          <h2 id="blason-t" class="block-title block-title--light">Le blason</h2>
          <p class="blason__blasonnement">« {blason.blasonnement} »</p>
          <p class="blason__explication">{blason.explication}</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .sites__list { margin-top: 28px; display: grid; gap: clamp(20px, 3vw, 40px); }
  .site { padding-bottom: clamp(20px, 3vw, 40px); border-bottom: 1px solid var(--trait); }
  .site:last-child { border-bottom: 0; padding-bottom: 0; }
  .site--media { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(24px, 4vw, 48px); align-items: center; }
  .site--media.site--alt { grid-template-columns: 1.15fr 0.85fr; }
  .site--media.site--alt .site__media { order: 2; }
  .site__media { position: relative; margin: 0; aspect-ratio: 4 / 3; overflow: hidden; }
  .site__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .site__media .credit { position: absolute; right: 10px; bottom: 8px; margin: 0; }
  .site__periode {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sinople);
    font-weight: 600;
  }
  .site__nom { font-family: var(--serif); font-size: clamp(24px, 3vw, 34px); margin: 6px 0 10px; line-height: 1.08; }
  .site__resume { margin: 0 0 10px; font-size: 17px; font-weight: 600; color: var(--encre); }
  .site__detail { margin: 0; font-size: 15.5px; line-height: 1.65; color: var(--encre-douce); max-width: 62ch; }

  /* Timeline */
  .timeline { list-style: none; margin: 26px 0 0; padding: 0; display: grid; gap: 0; }
  .tl {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 24px;
    padding: 16px 0;
    border-top: 1px solid var(--trait-clair);
    align-items: baseline;
  }
  .tl:last-child { border-bottom: 1px solid var(--trait-clair); }
  .tl__annee {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 600;
    color: var(--or-clair);
    font-variant-numeric: tabular-nums;
  }
  .tl__evt { color: var(--sur-vert); font-size: 16px; line-height: 1.55; }

  /* Personnalités */
  .perso__grid {
    margin-top: 26px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--trait);
    border-block: 2px solid var(--or);
  }
  .perso-card { background: var(--creme); padding: clamp(20px, 2.4vw, 26px); }
  .perso-card__nom { display: block; font-family: var(--serif); font-size: 21px; margin-bottom: 8px; }
  .perso-card__role { margin: 0; font-size: 15px; line-height: 1.55; color: var(--encre-douce); }

  /* Blason */
  .blason__grid { display: grid; grid-template-columns: auto 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .blason__img { width: clamp(96px, 12vw, 130px); height: auto; filter: drop-shadow(0 8px 20px rgba(0,0,0,0.25)); }
  .blason__blasonnement {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(20px, 2.4vw, 26px);
    color: var(--or-clair);
    margin: 14px 0 14px;
    line-height: 1.3;
  }
  .blason__explication { margin: 0; color: var(--sur-vert); font-size: 16px; line-height: 1.65; max-width: 60ch; }

  @media (max-width: 820px) {
    .site--media, .site--media.site--alt { grid-template-columns: 1fr; gap: 18px; }
    .site--media.site--alt .site__media { order: 0; }
    .blason__grid { grid-template-columns: 1fr; justify-items: start; gap: 18px; }
    .tl { grid-template-columns: 76px 1fr; gap: 16px; }
  }
</style>
