---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { mairie } from "../../data/commune";
import { web3formsKey, formsConfigured } from "../../data/forms";

const salles = [
  { nom: "Halle des Fêtes", detail: "Grande salle · marchés, repas, manifestations" },
  { nom: "Salle COSEC", detail: "Salle multisports · 3 rue Aloyse Meyer" },
  { nom: "Espace Arthuss", detail: "Auditorium & salles · Logelbach" },
];
const arrow =
  '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>';
---

<Base
  title="Réserver une salle — Wintzenheim"
  description="Demande de réservation d'une salle communale à Wintzenheim : Halle des Fêtes, COSEC, Espace Arthuss. Formulaire en ligne, la mairie revient vers vous."
>
  <PageHero
    kicker="Vie locale"
    title="Réserver une salle"
    lede="Particuliers et associations peuvent demander une salle communale. Remplissez le formulaire : la mairie étudie la disponibilité et vous répond."
    crumbs={[{ label: "Réserver une salle" }]}
  />

  <section class="section">
    <div class="container resa">
      <div class="resa__salles">
        {salles.map((s) => (
          <article class="resa__salle">
            <strong>{s.nom}</strong>
            <span>{s.detail}</span>
          </article>
        ))}
      </div>

      <form id="resaForm" class="pubform" data-configured={String(formsConfigured)} data-mairie-email={mairie.email} data-sujet="Demande de réservation de salle">
        <input type="hidden" name="access_key" value={web3formsKey} />
        <input type="hidden" name="subject" value="Demande de réservation de salle — Wintzenheim" />
        <input type="hidden" name="from_name" value="Site de Wintzenheim" />
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="pf-field">
          <label for="r_salle">Salle souhaitée *</label>
          <select id="r_salle" name="salle" required>
            {salles.map((s) => <option value={s.nom}>{s.nom}</option>)}
          </select>
        </div>
        <div class="pf-row">
          <div class="pf-field"><label for="r_date">Date *</label><input id="r_date" name="date" type="date" required /></div>
          <div class="pf-field"><label for="r_nb">Nombre de personnes</label><input id="r_nb" name="nombre_personnes" type="number" min="1" /></div>
        </div>
        <div class="pf-row">
          <div class="pf-field"><label for="r_h1">Heure de début</label><input id="r_h1" name="heure_debut" type="time" /></div>
          <div class="pf-field"><label for="r_h2">Heure de fin</label><input id="r_h2" name="heure_fin" type="time" /></div>
        </div>
        <div class="pf-field"><label for="r_motif">Motif *</label><input id="r_motif" name="motif" type="text" required placeholder="Réunion, repas associatif, anniversaire…" /></div>
        <div class="pf-row">
          <div class="pf-field"><label for="r_nom">Nom et prénom *</label><input id="r_nom" name="nom" type="text" required autocomplete="name" /></div>
          <div class="pf-field"><label for="r_tel">Téléphone *</label><input id="r_tel" name="telephone" type="tel" required autocomplete="tel" /></div>
        </div>
        <div class="pf-field"><label for="r_email">E-mail *</label><input id="r_email" name="email" type="email" required autocomplete="email" /></div>
        <div class="pf-field"><label for="r_msg">Message (optionnel)</label><textarea id="r_msg" name="message" rows="3"></textarea></div>
        <label class="pf-check"><input type="checkbox" name="reglement" required /> <span>J'ai pris connaissance et j'accepte le règlement d'utilisation des salles communales. *</span></label>

        <button type="submit" class="btn btn--primary">Envoyer ma demande <Fragment set:html={arrow} /></button>
        <p class="resa__note">Cette demande ne vaut pas confirmation : la mairie vous recontacte pour valider la réservation.</p>

        <div class="pf-done" id="resaDone"><strong>Demande envoyée.</strong><span>La mairie vous recontactera pour confirmer la disponibilité.</span></div>
      </form>
    </div>
  </section>
</Base>

<style>
  .resa { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(24px, 4vw, 48px); align-items: start; }
  .resa__salles { display: grid; gap: 12px; }
  .resa__salle { background: var(--creme-3); border-left: 3px solid var(--or); padding: 16px 18px; }
  .resa__salle strong { display: block; font-family: var(--serif); font-size: 20px; }
  .resa__salle span { font-size: 14px; color: var(--muted); }
  .resa__note { margin: 12px 0 0; font-size: 13.5px; color: var(--muted); }
  @media (max-width: 820px) { .resa { grid-template-columns: 1fr; } }
</style>

<script>
  import { initPublicForm } from "../../lib/forms-client";
  initPublicForm("resaForm", (etat) => {
    if (etat === "erreur") return;
    const f = document.getElementById("resaForm");
    const d = document.getElementById("resaDone");
    if (f) f.querySelectorAll("input,textarea,select,button").forEach((e) => ((e as HTMLInputElement).disabled = true));
    d?.classList.add("is-on");
    d?.scrollIntoView({ behavior: "smooth", block: "center" });
  });
</script>
