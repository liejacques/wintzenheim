---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { mairie } from "../../data/commune";
import { web3formsKey, formsConfigured } from "../../data/forms";
---

<Base
  title="Newsletter — Wintzenheim"
  description="Inscrivez-vous à la lettre d'information de la commune de Wintzenheim et recevez les actualités, l'agenda et les infos pratiques."
>
  <PageHero
    kicker="Rester informé"
    title="La lettre d'information"
    lede="Recevez par e-mail les actualités, l'agenda et les informations pratiques de la commune. Désinscription possible à tout moment."
    crumbs={[{ label: "Newsletter" }]}
  />

  <section class="section">
    <div class="container nl">
      <form id="nlForm" class="pubform" data-configured={String(formsConfigured)} data-mairie-email={mairie.email} data-sujet="Inscription newsletter">
        <input type="hidden" name="access_key" value={web3formsKey} />
        <input type="hidden" name="subject" value="Inscription newsletter — Wintzenheim" />
        <input type="hidden" name="from_name" value="Site de Wintzenheim" />
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="pf-field">
          <label for="nl_email">Votre adresse e-mail *</label>
          <input id="nl_email" name="email" type="email" required autocomplete="email" placeholder="prenom.nom@exemple.fr" />
        </div>
        <label class="pf-check"><input type="checkbox" name="consentement" required /> <span>J'accepte de recevoir la lettre d'information de la commune et que mon e-mail soit conservé à cette seule fin (<a href="/confidentialite/">confidentialité</a>). *</span></label>
        <button type="submit" class="btn btn--primary">M'inscrire</button>
        <div class="pf-done" id="nlDone"><strong>Inscription enregistrée.</strong><span>Merci ! Vous recevrez bientôt les prochaines lettres.</span></div>
      </form>

      <aside class="nl__aside">
        <h2 class="nl__t">Ce que vous recevez</h2>
        <ul class="nl__list">
          <li>Les actualités importantes de la commune</li>
          <li>L'agenda des événements et animations</li>
          <li>Les informations pratiques (travaux, déchets, démarches)</li>
        </ul>
        <p class="nl__note">Une à deux lettres par mois, sans publicité. Désinscription en un clic.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .nl { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(24px, 4vw, 48px); align-items: start; }
  .nl__aside { background: var(--creme-3); padding: clamp(20px, 2.6vw, 28px); }
  .nl__t { font-size: clamp(20px, 2.6vw, 26px); margin: 0 0 12px; }
  .nl__list { margin: 0 0 14px; padding-left: 18px; display: grid; gap: 8px; font-size: 15.5px; line-height: 1.5; }
  .nl__note { margin: 0; font-size: 13.5px; color: var(--muted); }
  @media (max-width: 820px) { .nl { grid-template-columns: 1fr; } }
</style>

<script>
  import { initPublicForm } from "../../lib/forms-client";
  initPublicForm("nlForm", (etat) => {
    if (etat === "erreur") return;
    const f = document.getElementById("nlForm");
    if (f) f.querySelectorAll("input,button").forEach((e) => ((e as HTMLInputElement).disabled = true));
    document.getElementById("nlDone")?.classList.add("is-on");
  });
</script>
