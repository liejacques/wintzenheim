---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { mairie, annexe, mapsUrl } from "../../data/commune";
import { urgences, servicesProximite, transports } from "../../data/pratique";
import { web3formsKey, formsConfigured } from "../../data/forms";

// Itinéraire vers la mairie (ouvre Google Maps)
const itineraire = mapsUrl(`${mairie.nom}, ${mairie.adresse}, ${mairie.cp} ${mairie.ville}`);

const arrow =
  '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>';
const sujets = [
  "Question générale",
  "État civil & papiers",
  "Urbanisme",
  "Rendez-vous avec le maire",
  "Vie associative & salles",
  "Autre",
];
---

<Base
  title="Contact & horaires — Mairie de Wintzenheim"
  description="Coordonnées, horaires et plan d'accès de la mairie de Wintzenheim et de la mairie annexe de Logelbach. Numéros utiles, services de proximité et transports."
>
  <PageHero
    kicker="Nous joindre"
    title="Contact & accès"
    lede="Horaires, adresses et numéros utiles pour joindre la mairie de Wintzenheim, la mairie annexe de Logelbach et les services de proximité."
    crumbs={[{ label: "Contact" }]}
  />

  <!-- Mairie principale -->
  <section class="section main-contact" aria-labelledby="mc-t">
    <div class="container section__pad">
      <div class="main-contact__grid">
        <div>
          <p class="kicker"><span class="kicker__tick"></span><span class="kicker__label">Hôtel de ville</span></p>
          <h2 id="mc-t" class="block-title">{mairie.nom}</h2>
          <address class="big-addr">
            <a href={mapsUrl(`${mairie.nom}, ${mairie.adresse}, ${mairie.cp} ${mairie.ville}`)} rel="noopener" target="_blank">{mairie.adresse}<br />{mairie.cp} {mairie.ville}</a><br /><br />
            <a href={`tel:${mairie.telE164}`}>{mairie.tel}</a><br />
            <a href={`mailto:${mairie.email}`}>{mairie.email}</a>
          </address>
          <a class="btn btn--ghost" href={itineraire} rel="noopener" target="_blank">
            Calculer mon itinéraire<span aria-hidden="true"> ↗</span>
          </a>
        </div>
        <div class="hours-card">
          <h3 class="card-label">Horaires d'ouverture au public</h3>
          <dl class="hours">
            {mairie.horaires.map((h) => (
              <div class="hours__row">
                <dt>{h.jour}</dt>
                <dd>{h.h}</dd>
              </div>
            ))}
          </dl>
          <p class="hours__note">{mairie.noteHoraires}</p>
          <p class="hours__live">
            <span class="hours__dot" data-office-dot aria-hidden="true"></span>
            <span data-office-status>Consulter les horaires</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Écrire à la mairie / rendez-vous -->
  <section id="ecrire" class="section--cream3 ecrire" aria-labelledby="ecrire-t">
    <div class="container section__pad">
      <div class="ecrire__grid">
        <div class="ecrire__intro">
          <p class="kicker"><span class="kicker__tick"></span><span class="kicker__label">Nous écrire</span></p>
          <h2 id="ecrire-t" class="block-title">Envoyer un message</h2>
          <p class="ecrire__lede">
            Une question, une demande, un rendez-vous&nbsp;? Écrivez-nous : votre message
            arrive directement à la mairie, qui vous répond par e-mail ou par téléphone.
          </p>
          <div class="ecrire__maire">
            <h3 class="ecrire__maire-t">Rencontrer le maire</h3>
            <p>
              Le maire et les adjoints reçoivent sur rendez-vous. Choisissez l'objet
              «&nbsp;Rendez-vous avec le maire&nbsp;» dans le formulaire, ou appelez la mairie
              au <a href={`tel:${mairie.telE164}`}>{mairie.tel}</a>.
            </p>
          </div>
        </div>

        <form id="contactForm" class="ecrire__form" novalidate
          data-configured={String(formsConfigured)} data-mairie-email={mairie.email}>
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="Nouveau message — site de Wintzenheim" />
          <input type="hidden" name="from_name" value="Site de Wintzenheim" />
          <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="ct-field">
            <label for="ctNom">Nom et prénom *</label>
            <input id="ctNom" name="nom" type="text" required autocomplete="name" />
          </div>
          <div class="ct-row">
            <div class="ct-field">
              <label for="ctEmail">E-mail *</label>
              <input id="ctEmail" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="ct-field">
              <label for="ctTel">Téléphone</label>
              <input id="ctTel" name="telephone" type="tel" autocomplete="tel" />
            </div>
          </div>
          <div class="ct-field">
            <label for="ctSujet">Objet</label>
            <select id="ctSujet" name="objet">
              {sujets.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>
          <div class="ct-field">
            <label for="ctMsg">Votre message *</label>
            <textarea id="ctMsg" name="message" rows="5" required></textarea>
          </div>
          <label class="ct-check">
            <input id="ctConsent" name="consentement" type="checkbox" required />
            <span>J'accepte que mes données soient utilisées pour traiter ma demande (<a href="/confidentialite/">confidentialité</a>). *</span>
          </label>
          <p class="ct-err" id="ctErr" role="alert"></p>
          <button type="submit" class="btn btn--primary ct-send">Envoyer le message <Fragment set:html={arrow} /></button>
          <p class="ct-status" id="ctStatus" role="status" aria-live="polite"></p>

          <div class="ct-done" id="ctDone" hidden>
            <strong>Merci, votre message est transmis.</strong>
            <span>La mairie vous répondra dans les meilleurs délais.</span>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Mairie annexe Logelbach -->
  <section id="logelbach" class="section--sinople annexe" aria-labelledby="annexe-t">
    <div class="container section__pad">
      <div class="annexe__grid">
        <div>
          <p class="kicker kicker--gold"><span class="kicker__tick"></span><span class="kicker__label">Quartier de Logelbach</span></p>
          <h2 id="annexe-t" class="block-title block-title--light">{annexe.nom}</h2>
          <p class="annexe__lede">
            Une permanence de proximité est assurée à Logelbach pour les habitants
            du quartier.
          </p>
        </div>
        <address class="annexe__addr">
          <span class="annexe__h">{annexe.horaires}</span>
          <a href={`tel:${annexe.telE164}`}>{annexe.tel}</a><br />
          <a href={`mailto:${annexe.email}`}>{annexe.email}</a>
        </address>
      </div>
    </div>
  </section>

  <!-- Numéros d'urgence -->
  <section class="section urgences" aria-labelledby="urg-t">
    <div class="container section__pad">
      <p class="kicker"><span class="kicker__tick"></span><span class="kicker__label">En cas d'urgence</span></p>
      <h2 id="urg-t" class="block-title">Numéros utiles</h2>
      <ul class="urg-grid">
        {urgences.map((u) => (
          <li class="urg">
            <a href={`tel:${u.num.replace(/\s/g, "")}`}>
              <span class="urg__num">{u.num}</span>
              <span class="urg__label">{u.label}</span>
            </a>
          </li>
        ))}
      </ul>

      <h3 class="sub-title">Services de proximité</h3>
      <div class="prox-grid">
        {servicesProximite.map((s) => (
          <article class="prox">
            <strong class="prox__nom">{s.nom}</strong>
            {/\d\d\d\d\d/.test(s.detail) ? (
              <p class="prox__detail"><a href={mapsUrl(`${s.nom}, ${s.detail}`)} rel="noopener" target="_blank">{s.detail}</a></p>
            ) : (
              <p class="prox__detail">{s.detail}</p>
            )}
            {s.tel && <a class="prox__tel" href={`tel:${s.telE164}`}>{s.tel}</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Transports -->
  <section class="section--dark transports" aria-labelledby="tr-t">
    <div class="container section__pad">
      <div class="transports__grid">
        <div>
          <p class="kicker kicker--gold"><span class="kicker__tick"></span><span class="kicker__label">Se déplacer</span></p>
          <h2 id="tr-t" class="block-title block-title--light">Venir & circuler</h2>
          <p class="transports__lede">{transports.intro}</p>
          <p class="transports__contact">{transports.contact}</p>
          <a class="arrow-link arrow-link--underline transports__cta" href={transports.lien} rel="noopener" target="_blank">
            Réseau TRACE Colmar<span aria-hidden="true"> ↗</span>
          </a>
        </div>
        <ul class="lignes">
          {transports.lignes.map((l) => (
            <li class="ligne">
              <strong class="ligne__nom">{l.nom}</strong>
              <span class="ligne__detail">{l.detail}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .block-title { margin-bottom: 18px; }
  .sub-title {
    font-family: var(--sans);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sinople);
    font-weight: 600;
    margin: 44px 0 16px;
  }
  .card-label {
    font-family: var(--sans);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sinople);
    font-weight: 600;
    margin: 0 0 14px;
  }

  .main-contact__grid,
  .annexe__grid,
  .transports__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  .big-addr {
    font-style: normal;
    font-size: 18px;
    line-height: 1.7;
    margin: 0 0 22px;
  }
  .big-addr a {
    color: var(--sinople);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid var(--or);
    overflow-wrap: anywhere;
  }
  .big-addr a:hover { border-color: var(--sinople); }

  .hours-card {
    background: var(--creme-3);
    border-top: 2px solid var(--or);
    padding: clamp(20px, 2.6vw, 30px);
  }
  .hours { margin: 0; }
  .hours__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-top: 1px solid var(--trait);
  }
  .hours__row:first-child { border-top: 0; }
  .hours__row dd {
    margin: 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .hours__note {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  .hours__live {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--trait);
    font-weight: 600;
    font-size: 14.5px;
  }
  .hours__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--or);
    flex: none;
  }
  .hours__dot.is-open { background: #2f9c54; }

  /* Annexe */
  .annexe__grid { align-items: center; }
  .annexe__lede {
    margin: 14px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--sur-vert);
    max-width: 46ch;
  }
  .annexe__addr {
    font-style: normal;
    font-size: 17px;
    line-height: 1.8;
    background: rgba(255, 255, 255, 0.08);
    border-top: 2px solid var(--or-clair);
    padding: clamp(18px, 2.4vw, 26px);
    color: #ebe6d6;
  }
  .annexe__h { display: block; margin-bottom: 10px; color: #fff; font-weight: 600; }
  .annexe__addr a {
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid var(--or);
    overflow-wrap: anywhere;
  }
  .annexe__addr a:hover { border-color: #fff; }

  /* Urgences */
  .urg-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    background: var(--trait);
    border-block: 2px solid var(--or);
  }
  .urg a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    background: var(--creme);
    text-decoration: none;
    color: inherit;
    min-height: 64px;
  }
  .urg a:hover { background: #f0f3ee; }
  .urg__num {
    flex: none;
    font-family: var(--serif);
    font-size: 26px;
    font-weight: 600;
    color: var(--sinople);
    min-width: 56px;
  }
  .urg__label { font-size: 14.5px; line-height: 1.4; }

  .prox-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .prox {
    border: 1px solid var(--trait);
    padding: 18px 20px;
    background: var(--creme);
  }
  .prox__nom { display: block; font-family: var(--serif); font-size: 20px; }
  .prox__detail { margin: 6px 0 8px; font-size: 14.5px; color: var(--muted); line-height: 1.5; }
  .prox__detail a { color: var(--sinople); text-decoration: underline; text-underline-offset: 2px; text-decoration-color: var(--or); }
  .prox__detail a:hover { text-decoration-thickness: 2px; }
  .prox__tel {
    color: var(--sinople);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid var(--or);
  }

  /* Transports */
  .transports__lede {
    margin: 14px 0 14px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--sur-vert);
    max-width: 48ch;
  }
  .transports__contact { font-size: 15px; color: var(--sur-vert-muted); margin: 0 0 16px; }
  .transports__cta { color: #fff; }
  .lignes { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--trait-clair); border-block: 2px solid var(--or-clair); }
  .ligne { background: var(--vert-profond); padding: 18px 20px; }
  .ligne__nom { display: block; font-family: var(--serif); font-size: 20px; color: var(--or-clair); }
  .ligne__detail { font-size: 15px; color: var(--sur-vert); }

  section { scroll-margin-top: 20px; }

  /* Écrire à la mairie */
  .section--cream3 { background: var(--creme-3); border-top: 1px solid var(--trait); }
  .ecrire__grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(28px, 4vw, 56px); align-items: start; }
  .ecrire__lede { margin: 14px 0 0; font-size: 16.5px; line-height: 1.6; color: var(--encre-douce); max-width: 46ch; }
  .ecrire__maire { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--trait); }
  .ecrire__maire-t { font-family: var(--sans); font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sinople); font-weight: 600; margin: 0 0 8px; }
  .ecrire__maire p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--encre-douce); }
  .ecrire__maire a { color: var(--sinople); font-weight: 600; }

  .ecrire__form { background: var(--creme); border-top: 3px solid var(--or); padding: clamp(20px, 2.6vw, 30px); }
  .ct-field { margin-bottom: 14px; }
  .ct-field label { display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px; }
  .ct-field input, .ct-field textarea, .ct-field select { width: 100%; padding: 11px 13px; border: 1px solid var(--trait-fort); background: #fff; font: 400 16px/1.4 var(--sans); color: var(--encre); }
  .ct-field input:focus, .ct-field textarea:focus, .ct-field select:focus { outline: 2px solid var(--sinople); outline-offset: 1px; border-color: var(--sinople); }
  .ct-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .ct-check { display: flex; gap: 10px; align-items: flex-start; margin: 4px 0 16px; font-size: 14px; line-height: 1.45; }
  .ct-check input { margin-top: 3px; width: 18px; height: 18px; flex: none; accent-color: var(--sinople); }
  .ct-check a { color: var(--sinople); }
  .ct-err { color: #b3261e; font-weight: 600; font-size: 14px; min-height: 1.2em; margin: 0 0 8px; }
  .ct-send { min-height: 48px; }
  .ct-status { margin: 12px 0 0; font-weight: 600; }
  .ct-status.ko { color: #b3261e; }
  .ct-done { display: flex; flex-direction: column; gap: 4px; margin-top: 16px; padding: 16px 18px; background: rgba(31,107,58,0.08); border-left: 3px solid var(--sinople); }
  .ct-done strong { font-family: var(--serif); font-size: 19px; }

  @media (max-width: 820px) {
    .main-contact__grid,
    .annexe__grid,
    .transports__grid,
    .ecrire__grid { grid-template-columns: 1fr; }
    .ct-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  const cf = document.getElementById("contactForm");
  if (cf instanceof HTMLFormElement) {
    const err = document.getElementById("ctErr");
    const status = document.getElementById("ctStatus");
    const v = (id) => { const el = document.getElementById(id); return el && "value" in el ? String(el.value).trim() : ""; };
    const done = () => {
      const d = document.getElementById("ctDone");
      cf.querySelector(".ct-send")?.setAttribute("hidden", "");
      if (d) d.hidden = false;
    };
    function mailto() {
      const email = cf.dataset.mairieEmail || "";
      const corps = [
        "Objet : " + v("ctSujet"),
        "Nom : " + v("ctNom"),
        "E-mail : " + v("ctEmail"),
        "Téléphone : " + (v("ctTel") || "—"),
        "",
        v("ctMsg"),
      ].join("\n");
      window.location.href = "mailto:" + email + "?subject=" + encodeURIComponent(v("ctSujet") + " — " + v("ctNom")) + "&body=" + encodeURIComponent(corps);
    }
    async function web3() {
      const payload = {};
      new FormData(cf).forEach((val, k) => { if (typeof val === "string") payload[k] = val; });
      const res = await fetch("https://api.web3forms.com/submit", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(payload) });
      return !!(await res.json()).success;
    }
    cf.addEventListener("submit", (e) => {
      e.preventDefault();
      if (err) err.textContent = "";
      const consent = document.getElementById("ctConsent");
      if (!v("ctNom")) { if (err) err.textContent = "Indiquez votre nom."; return; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v("ctEmail"))) { if (err) err.textContent = "Adresse e-mail invalide."; return; }
      if (v("ctMsg").length < 5) { if (err) err.textContent = "Écrivez votre message."; return; }
      if (consent instanceof HTMLInputElement && !consent.checked) { if (err) err.textContent = "Merci d'accepter l'utilisation de vos données."; return; }
      const local = ["localhost", "127.0.0.1"].includes(location.hostname);
      if (local) { done(); return; }
      if (cf.dataset.configured !== "true") { mailto(); done(); return; }
      if (status) { status.textContent = "Envoi en cours…"; status.className = "ct-status"; }
      web3().then((ok) => { if (ok) done(); else if (status) { status.textContent = "L'envoi a échoué. Réessayez ou écrivez par e-mail."; status.className = "ct-status ko"; } })
        .catch(() => { if (status) { status.textContent = "L'envoi a échoué. Réessayez ou écrivez par e-mail."; status.className = "ct-status ko"; } });
    });
  }
</script>
