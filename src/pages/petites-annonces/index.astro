---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { mairie } from "../../data/commune";
import { web3formsKey, formsConfigured } from "../../data/forms";
import { seedClassifieds } from "../../lib/cms/seed";

// Annonces publiées = celles validées par la mairie (modération).
const annonces = seedClassifieds.filter((a) => a.statut === "acceptee");
const categories = ["Dons", "Vente", "Recherche", "Services", "Emploi", "Divers"];
---

<Base
  title="Petites annonces — Wintzenheim"
  description="Petites annonces entre habitants de Wintzenheim : dons, ventes, recherches, services. Déposez votre annonce, validée par la mairie avant publication."
>
  <PageHero
    kicker="Entre habitants"
    title="Petites annonces"
    lede="Dons, ventes, services, recherches… Consultez les annonces des habitants ou déposez la vôtre. Chaque annonce est validée par la mairie avant publication."
    crumbs={[{ label: "Petites annonces" }]}
  />

  <section class="section">
    <div class="container pa">
      <div class="pa__list">
        <h2 class="pa__h">Annonces en cours</h2>
        {annonces.length === 0 ? (
          <p class="pa__empty">Aucune annonce publiée pour le moment. Soyez le premier à en déposer une&nbsp;!</p>
        ) : (
          <ul class="pa__items">
            {annonces.map((a) => (
              <li class="pa__item">
                <span class="pa__cat">{a.categorie}</span>
                <strong class="pa__titre">{a.titre}</strong>
                <p class="pa__desc">{a.description}</p>
                <span class="pa__contact">Contact : {a.contact}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <form id="paForm" class="pubform pa__form" data-configured={String(formsConfigured)} data-mairie-email={mairie.email} data-sujet="Dépôt de petite annonce">
        <h2 class="pa__h">Déposer une annonce</h2>
        <input type="hidden" name="access_key" value={web3formsKey} />
        <input type="hidden" name="subject" value="Dépôt de petite annonce — Wintzenheim" />
        <input type="hidden" name="from_name" value="Site de Wintzenheim" />
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="pf-field"><label for="a_titre">Titre *</label><input id="a_titre" name="titre" type="text" required /></div>
        <div class="pf-field"><label for="a_cat">Catégorie</label><select id="a_cat" name="categorie">{categories.map((c) => <option>{c}</option>)}</select></div>
        <div class="pf-field"><label for="a_desc">Description *</label><textarea id="a_desc" name="description" rows="4" required></textarea></div>
        <div class="pf-field"><label for="a_contact">Vos coordonnées (affichées) *</label><input id="a_contact" name="contact" type="text" required placeholder="Téléphone ou e-mail" /></div>
        <label class="pf-check"><input type="checkbox" name="consentement" required /> <span>J'accepte que mon annonce soit relue par la mairie avant publication (<a href="/confidentialite/">confidentialité</a>). *</span></label>
        <button type="submit" class="btn btn--primary">Envoyer mon annonce</button>
        <p class="pa__note">Votre annonce est transmise à la mairie qui la publie après validation.</p>
        <div class="pf-done" id="paDone"><strong>Annonce envoyée.</strong><span>Elle sera publiée après validation par la mairie.</span></div>
      </form>
    </div>
  </section>
</Base>

<style>
  .pa { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(24px, 4vw, 48px); align-items: start; }
  .pa__h { font-size: clamp(20px, 2.6vw, 26px); margin: 0 0 16px; }
  .pa__items { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .pa__item { background: var(--creme); border-left: 3px solid var(--or); padding: 16px 18px; }
  .pa__cat { font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--sinople); font-weight: 700; }
  .pa__titre { display: block; font-family: var(--serif); font-size: 20px; margin: 3px 0 6px; }
  .pa__desc { margin: 0 0 8px; font-size: 15px; color: var(--encre-douce); }
  .pa__contact { font-size: 13.5px; color: var(--muted); }
  .pa__empty { background: var(--creme-3); border: 1px dashed var(--trait-fort); padding: 26px; color: var(--muted); }
  @media (max-width: 820px) { .pa { grid-template-columns: 1fr; } }
</style>

<script>
  import { initPublicForm } from "../../lib/forms-client";
  initPublicForm("paForm", (etat) => {
    if (etat === "erreur") return;
    const f = document.getElementById("paForm");
    if (f) f.querySelectorAll("input,textarea,select,button").forEach((e) => ((e as HTMLInputElement).disabled = true));
    document.getElementById("paDone")?.classList.add("is-on");
  });
</script>
