---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import {
  ecoles,
  ecolePrivee,
  enfanceJeunesse,
  culture,
  associations,
  sportEquipements,
  solidarite,
} from "../../data/vie-locale";
import { mapsUrl } from "../../data/commune";
---

<Base
  title="Vie locale — Wintzenheim"
  description="Écoles, petite enfance et périscolaire, culture, associations, sport et solidarité à Wintzenheim et Logelbach. Tout ce qui fait la vie de la commune au quotidien."
>
  <PageHero
    kicker="Au cœur de la commune"
    title="Vie locale"
    lede="Écoles et jeunesse, culture, sport, associations et solidarité : la commune accompagne tous les âges de la vie, à Wintzenheim comme à Logelbach."
    crumbs={[{ label: "Vie locale" }]}
  />

  <!-- Écoles & jeunesse -->
  <section id="ecoles" class="section ecoles" aria-labelledby="ecoles-t">
    <div class="container section__pad">
      <p class="kicker"><span class="kicker__tick"></span><span class="kicker__label">Grandir à Wintzenheim</span></p>
      <h2 id="ecoles-t" class="block-title">Écoles & jeunesse</h2>
      <p class="lede">{enfanceJeunesse.intro}</p>

      <h3 class="sub-title">Établissements scolaires</h3>
      <div class="ecole-grid">
        {ecoles.map((e) => (
          <article class="ecole">
            <strong class="ecole__nom">{e.nom}</strong>
            <span class="ecole__quartier">{e.quartier}</span>
            <p class="ecole__addr"><a href={mapsUrl(`${e.nom}, ${e.adresse}, Wintzenheim`)} rel="noopener" target="_blank">{e.adresse}</a></p>
            <a class="ecole__tel" href={`tel:${e.tel.replace(/\s/g, "")}`}>{e.tel}</a>
          </article>
        ))}
        <article class="ecole ecole--privee">
          <strong class="ecole__nom">{ecolePrivee.nom}</strong>
          <span class="ecole__quartier">{ecolePrivee.quartier} · école privée</span>
          <p class="ecole__addr"><a href={mapsUrl(`${ecolePrivee.nom}, ${ecolePrivee.adresse}, Wintzenheim`)} rel="noopener" target="_blank">{ecolePrivee.adresse}</a></p>
          <p class="ecole__detail">{ecolePrivee.detail}</p>
        </article>
      </div>

      <h3 class="sub-title">Petite enfance & accueils</h3>
      <ul class="struct-list">
        {enfanceJeunesse.structures.map((s) => (
          <li class="struct">
            <strong>{s.nom}</strong>
            <span>{s.detail}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Culture & associations -->
  <section id="culture" class="section--cream3 culture" aria-labelledby="culture-t">
    <div class="container section__pad">
      <p class="kicker"><span class="kicker__tick"></span><span class="kicker__label">Sortir & participer</span></p>
      <h2 id="culture-t" class="block-title">Culture & associations</h2>

      <div class="culture-grid">
        {culture.map((c) => (
          <article class="culture-card">
            <strong class="culture-card__nom">{c.nom}</strong>
            <p class="culture-card__detail">{c.detail}</p>
            {c.contact && <p class="culture-card__contact">{c.contact}</p>}
            {c.lien && (
              <a class="culture-card__link" href={c.lien} rel="noopener" target="_blank">
                {c.libelleLien ?? "En savoir plus"}<span aria-hidden="true"> ↗</span>
              </a>
            )}
          </article>
        ))}
      </div>

      <h3 class="sub-title">Le tissu associatif</h3>
      <p class="assoc-intro">
        Wintzenheim compte une vie associative dense, du sport à la culture en passant
        par la solidarité. Voici quelques associations par famille — l'annuaire complet
        est tenu à jour par la commune.
      </p>
      <div class="assoc-grid">
        {associations.familles.map((f) => (
          <div class="assoc">
            <h4 class="assoc__famille">{f.famille}</h4>
            <ul class="assoc__list">
              {f.exemples.map((ex) => <li>{ex}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <a class="arrow-link assoc-cta" href={associations.annuaireUrl} rel="noopener" target="_blank">
        Voir l'annuaire complet des associations<span aria-hidden="true"> ↗</span>
      </a>
    </div>
  </section>

  <!-- Sport & solidarité -->
  <section id="sport" class="section--sinople sport" aria-labelledby="sport-t">
    <div class="container section__pad">
      <div class="sport__grid">
        <div>
          <p class="kicker kicker--gold"><span class="kicker__tick"></span><span class="kicker__label">Bouger & s'entraider</span></p>
          <h2 id="sport-t" class="block-title block-title--light">Sport & solidarité</h2>
          <h3 class="sport__label">Équipements sportifs</h3>
          <ul class="equip-list">
            {sportEquipements.map((s) => (
              <li class="equip">
                <strong>{s.nom}</strong>
                <span>{s.detail}{s.contact ? ` · ${s.contact}` : ""}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="solidarite">
          <h3 class="sport__label">Action sociale & solidarité</h3>
          <p class="solidarite__intro">{solidarite.intro}</p>
          <ul class="solidarite__list">
            {solidarite.dispositifs.map((d) => <li>{d}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .section--cream3 { background: var(--creme-3); border-top: 1px solid var(--trait); }
  .lede { margin: 16px 0 0; max-width: 64ch; font-size: 17px; line-height: 1.65; color: var(--encre-douce); }
  .sub-title {
    font-family: var(--sans);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sinople);
    font-weight: 600;
    margin: 40px 0 16px;
  }

  /* Écoles */
  .ecole-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--trait);
    border-block: 2px solid var(--or);
  }
  .ecole { background: var(--creme); padding: clamp(18px, 2.2vw, 24px); }
  .ecole--privee { background: var(--creme-3); }
  .ecole__nom { display: block; font-family: var(--serif); font-size: 20px; line-height: 1.15; }
  .ecole__quartier {
    display: inline-block;
    margin: 8px 0 6px;
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sinople);
    font-weight: 600;
  }
  .ecole__addr { margin: 0 0 6px; font-size: 14.5px; color: var(--muted); }
  .ecole__addr a { color: var(--sinople); text-decoration: underline; text-underline-offset: 2px; text-decoration-color: var(--or); }
  .ecole__addr a:hover { text-decoration-thickness: 2px; }
  .ecole__detail { margin: 0; font-size: 14px; color: var(--muted); line-height: 1.5; }
  .ecole__tel { color: var(--sinople); text-decoration: none; font-weight: 600; border-bottom: 1px solid var(--or); }

  .struct-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .struct {
    display: grid;
    grid-template-columns: minmax(180px, 0.6fr) 1fr;
    gap: 6px 24px;
    padding: 16px 0;
    border-top: 1px solid var(--trait);
  }
  .struct:first-child { border-top: 0; }
  .struct strong { font-family: var(--serif); font-size: 20px; }
  .struct span { color: var(--encre-douce); font-size: 15.5px; line-height: 1.55; }

  /* Culture */
  .culture-grid {
    margin-top: 26px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .culture-card {
    background: var(--creme);
    border-top: 2px solid var(--or);
    padding: clamp(20px, 2.4vw, 26px);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .culture-card__nom { font-family: var(--serif); font-size: 22px; }
  .culture-card__detail { margin: 0; font-size: 15px; line-height: 1.55; color: var(--encre-douce); }
  .culture-card__contact { margin: 0; font-size: 14px; color: var(--muted); }
  .culture-card__link {
    margin-top: auto;
    align-self: start;
    color: var(--sinople);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--or);
    padding-bottom: 3px;
  }
  .culture-card__link:hover { border-color: var(--sinople); }

  .assoc-intro { max-width: 66ch; color: var(--encre-douce); font-size: 16px; line-height: 1.6; margin: 0 0 22px; }
  .assoc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    background: var(--trait);
    border-block: 2px solid var(--or);
  }
  .assoc { background: var(--creme); padding: clamp(18px, 2.2vw, 24px); }
  .assoc__famille { font-family: var(--serif); font-size: 21px; margin: 0 0 12px; color: var(--sinople); }
  .assoc__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 14.5px; line-height: 1.45; }
  .assoc__list li { padding-left: 14px; position: relative; }
  .assoc__list li::before { content: ""; position: absolute; left: 0; top: 9px; width: 5px; height: 5px; background: var(--or); border-radius: 50%; }
  .assoc-cta { margin-top: 22px; }

  /* Sport & solidarité */
  .sport__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 4vw, 56px); align-items: start; }
  .sport__label {
    font-family: var(--sans);
    font-size: 12.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--or-clair);
    font-weight: 600;
    margin: 28px 0 14px;
  }
  .equip-list, .solidarite__list { list-style: none; margin: 0; padding: 0; }
  .equip { padding: 14px 0; border-top: 1px solid var(--trait-clair); }
  .equip:first-child { border-top: 0; }
  .equip strong { display: block; font-family: var(--serif); font-size: 20px; color: #fff; }
  .equip span { font-size: 14.5px; color: var(--sur-vert-muted); }
  .solidarite__intro { color: var(--sur-vert); font-size: 16px; line-height: 1.6; margin: 0 0 16px; max-width: 46ch; }
  .solidarite__list { display: grid; gap: 8px; }
  .solidarite__list li { padding-left: 16px; position: relative; color: var(--sur-vert); font-size: 15px; }
  .solidarite__list li::before { content: ""; position: absolute; left: 0; top: 9px; width: 6px; height: 6px; background: var(--or-clair); border-radius: 50%; }

  section { scroll-margin-top: 20px; }

  @media (max-width: 820px) {
    .sport__grid { grid-template-columns: 1fr; }
    .struct { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
